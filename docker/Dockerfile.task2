
# MetaBench-AI | Task 2
# Python environment for DML and negative-control analysis

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV OPENBLAS_NUM_THREADS=1
ENV OMP_NUM_THREADS=1
ENV MKL_NUM_THREADS=1

RUN pip install --no-cache-dir \
    numpy \
    pandas \
    scipy \
    scikit-learn \
    econml

WORKDIR /workspace

# Verify the scientific dependencies
RUN python -c "import numpy, pandas, scipy, sklearn, econml; print('Task 2 packages installed successfully')"

CMD ["python", "--version"]
